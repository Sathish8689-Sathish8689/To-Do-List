# Copy to .env and set real values. Never commit .env.
PORT=3000
DB_PATH=data/todo.db

# Seeded single account (created on first start when the database has no users)
ADMIN_NAME=Owner
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=

# Set to true when served over HTTPS (marks the session cookie Secure)
SECURE_COOKIES=false
# Set to true when running behind a reverse proxy that terminates TLS
TRUST_PROXY=false
SESSION_TTL_HOURS=24

# internal = worker runs inside the API process; external = run `npm run worker` separately
WORKER_MODE=internal
WORKER_INTERVAL_MS=15000

# debug | info | warn | error | silent
LOG_LEVEL=info
